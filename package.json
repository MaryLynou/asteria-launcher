{
  "name": "asteria-launcher",
  "version": "1.1.1",
  "description": "Launcher officiel du serveur Asteria (Dofus Retro 1.43.7)",
  "main": "src/main.js",
  "author": "Asteria",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MaryLynou/asteria-launcher"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish=never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.asteria.launcher",
    "productName": "Asteria Launcher",
    "publish": {
      "provider": "github",
      "owner": "MaryLynou",
      "repo": "asteria-launcher",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Asteria-Launcher-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Asteria Launcher",
      "artifactName": "Asteria-Launcher-Setup.${ext}"
    }
  }
}
